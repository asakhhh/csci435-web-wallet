{
  "manifest_version": 3,
  "name": "Minimalist HD Web Wallet",
  "version": "0.1.0",
  "description": "A browser extension HD wallet for account management and transaction signing.",
  "permissions": ["storage", "notifications"],
  "host_permissions": ["https://sepolia.infura.io/*", "https://*.infura.io/*", "https://*/*"],
  "action": {
    "default_title": "HD Wallet",
    "default_popup": "index.html"
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/index.ts"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/injected/provider.ts"],
      "matches": ["<all_urls>"]
    }
  ]
}
